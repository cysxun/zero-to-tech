# ===== 环境变量模板 =====
# 复制本文件为 .env.local 并按环境填写：
#   cp .env.example .env.local
# 注意：.env.local 被 .gitignore 忽略，不会提交到 git，
#       所以 server 那边 clone/pull 代码后要【自己创建】.env.local。

# --- 后端 API 地址（主页数据 / 文字实验室分析） ---
# 本地开发：
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 上线（推荐留空，走同源相对路径 /api/...，由 nginx 反代到后端 8000）：
#   NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Dify 聊天机器人地址 ---
# 本地开发（Dify 跑在本机 8088）：
#   NEXT_PUBLIC_DIFY_BASE_URL=http://localhost:8088
# 上线（推荐留空，运行时自动取当前站点域名 = 同源，
#       由 nginx 把 /embed.min.js、/chatbot/、/api/ 反代到 Dify 8088）：
#   NEXT_PUBLIC_DIFY_BASE_URL=
NEXT_PUBLIC_DIFY_BASE_URL=http://localhost:8088
